## Kurangi Ping 2 - Environment Contract (safe template)
## Copy to .env.local for local development and fill with non-production values.

KP_ENV=dev
KP_MANIFEST_URL=https://TBD.example.com/v1/relay/manifest
KP_MANIFEST_PUBKEY=TBD_PUBLIC_KEY_BASE64
KP_TELEMETRY_ENDPOINT=https://TBD.example.com/v1/telemetry/events:batch
KP_UPDATE_CHANNEL=beta
KP_RELAY_HEALTH_URL=https://TBD.example.com/v1/relay/health

## Relay probe contract (KP-127)
## Format: comma-separated list of relay target entries.
## Entry format: <relay_id>|<probe_url>
## Example:
## KP_RELAY_PROBE_TARGETS=sin-01|https://sin-01.example.net/healthz,nrt-01|https://nrt-01.example.net/healthz
KP_RELAY_PROBE_TARGETS=sin-01|https://TBD-sin.example.com/healthz,nrt-01|https://TBD-nrt.example.com/healthz

## Probe timeout in milliseconds. Safe default recommendation: 1200 ms.
KP_RELAY_PROBE_TIMEOUT_MS=1200
